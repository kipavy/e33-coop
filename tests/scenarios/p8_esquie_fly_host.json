{
  "name": "p8_esquie_fly_host",
  "description": "Diagnostic du vol d'Esquie (carte du monde, D19) : vrai jeu hôte face au faux client, save TEST_LATE. Monte sur Esquie par l'événement de la touche de monture (appelé par le code, aucune touche simulée), journalise les signatures des fonctions de mode de déplacement, puis essaie le décollage (événement de saut), le vol, la descente et l'atterrissage.",
  "save": "e33coop-test/TEST_LATE",
  "timeout_s": 600,
  "actions": [{ "type": "flee" }],
  "defense": ["fail"],
  "explore": [
    { "do": "wait_join", "players": 1, "timeout": 300 },
    { "do": "wait", "s": 2 },
    { "do": "change_map", "level": "Level_WorldMap_Main_V2" },
    { "do": "wait", "s": 5 },
    { "do": "wait_world", "s": 5, "timeout": 240 },
    { "do": "mount", "op": "sig", "target": "controller.BP_WorldMapControllerComponent", "fns": ["OnMountRequested", "ProcessMountRequest", "OnInputMountPressed", "ForceMountAtSpawn", "OnDismountRequested", "CanMount", "CanDismount", "IsUsingMount"] },
    { "do": "mount", "op": "call", "target": "controller", "fn": "InpActEvt_WorldMap_MountAction_K2Node_EnhancedInputActionEvent_2" },
    { "do": "mount", "op": "wait_mount", "is": true, "timeout": 20 },
    { "do": "mount", "op": "watch", "s": 3, "label": "mounted" },
    { "do": "mount", "op": "trace" },
    { "do": "mount", "op": "sig", "target": "possessed", "fns": ["TryChangeMovementMode", "ChangeMovementMode", "IsTransitionPossible", "IsMovementModeAllowed", "CanTakeOff", "CanLand", "EnterFlyMode", "ExitFlyMode", "EnterBoatMode", "EnterWalkingMode", "OnTakeOff", "IsInFlyMode", "IsInSwimMode", "GetCurrentMovementMode", "SetDefaultMovementMode", "AddImpulse", "ForwardMovementAction", "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "InpActEvt_WorldMap_FlyMovementUpAction_K2Node_EnhancedInputActionEvent_1", "InpActEvt_WorldMap_FlyMovementDownAction_K2Node_EnhancedInputActionEvent_0", "OnWorldMapMovementModeChanged_Event", "TryEnterZone", "GetLastFlyInputUnscaled"] },
    { "do": "mount", "op": "diag", "label": "mounted" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "optional": true },
    { "do": "mount", "op": "watch", "s": 4, "label": "after_jump" },
    { "do": "mount", "op": "move", "dir": [1, 0, 0], "s": 5, "label": "fly_x" },
    { "do": "mount", "op": "move", "dir": [0, 0, 1], "s": 3, "label": "fly_up" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_WorldMap_FlyMovementUpAction_K2Node_EnhancedInputActionEvent_1", "optional": true },
    { "do": "mount", "op": "watch", "s": 3, "label": "after_up_event" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "optional": true },
    { "do": "mount", "op": "watch", "s": 6, "label": "after_jump2" },
    { "do": "mount", "op": "move", "dir": [0, 1, 0], "s": 4, "label": "after_jump2_move" },
    { "do": "mount", "op": "diag", "label": "end" },
    { "do": "mount", "op": "call", "target": "controller", "fn": "OnDismountRequested", "optional": true },
    { "do": "mount", "op": "watch", "s": 4, "label": "after_dismount" }
  ],
  "launch_args": ["-e33role=host", "-e33port=7777", "-e33seed=1865"],
  "fakepeer": { "start": "after_game", "args": ["client", "--connect", "127.0.0.1:7777", "--script", "{repo}/tests/scenarios/fakeclient_follow.json", "--save-out", "{run}/snapshot-received.sav", "--record", "{run}/recording-fakeclient.jsonl", "--timeout", "600"] },
  "expect": { "snapshots_sent": "1", "joined_players": "1", "mount:diags": ">=2" }
}
