{
  "name": "p6_panelnav_input_host",
  "description": "INJECTE DE VRAIES ENTRÉES (clavier et souris dans la fenêtre du jeu) : à ne lancer qu'avec l'accord de Killian, PC libre (comme p7_menumirror_*). Panneau Coop au clavier et à la souris comme le menu du jeu : Droite depuis « Reprendre » entre dans le panneau, Bas / Haut parcourent les lignes, Entrée change la ligne, Gauche / Droite changent une valeur, Échap rend le focus au menu (menu toujours ouvert), survol puis clic sur la première ligne. Save TEST_B, équipe Maelle, Verso, Monoco. Manette : à vérifier à la main (croix, stick, A, B). Captures chaque seconde.",
  "save": "e33coop-test/TEST_B",
  "timeout_s": 600,
  "shots_every_s": 1,
  "actions": [{ "type": "attack" }],
  "defense": ["fail"],
  "explore": [
    { "do": "wait_join", "players": 1, "timeout": 300 },
    { "do": "wait", "s": 3 },
    { "do": "set_party", "party": ["Maelle", "Verso", "Monoco"] },
    { "do": "wait", "s": 2 },
    { "do": "pause_menu", "open": true },
    { "do": "wait", "s": 2, "check": { "panel:buttons": "9", "panel:menu_focus": "1" } },
    { "do": "input", "key": "right" },
    { "do": "wait", "s": 1, "check": { "panel:focused_row": "0", "panel:selected": "0" } },
    { "do": "input", "key": "down" },
    { "do": "wait", "s": 0.5 },
    { "do": "input", "key": "down" },
    { "do": "wait", "s": 1, "check": { "panel:focused_row": "2" } },
    { "do": "input", "key": "enter" },
    { "do": "wait", "s": 2, "check": { "owner_reassignments": "1", "panel:focused_row": "2" } },
    { "do": "input", "key": "right" },
    { "do": "wait", "s": 2, "check": { "owner_reassignments": "2", "panel:focused_row": "2" } },
    { "do": "input", "key": "down" },
    { "do": "wait", "s": 0.5 },
    { "do": "input", "key": "down" },
    { "do": "wait", "s": 1, "check": { "panel:focused_row": "4" } },
    { "do": "input", "key": "left" },
    { "do": "wait", "s": 1, "check": { "options:option_changes": "1", "panel:focused_row": "4" } },
    { "do": "input", "key": "up" },
    { "do": "wait", "s": 1, "check": { "panel:focused_row": "3" } },
    { "do": "input", "key": "escape" },
    { "do": "wait", "s": 2, "check": { "panel:focused_row": "-1", "panel:menu_focus": "1", "panel:menu_visible": "1" } },
    { "do": "input", "move": [0.8, 0.165] },
    { "do": "wait", "s": 1 },
    { "do": "input", "click": [0.8, 0.165] },
    { "do": "wait", "s": 2, "check": { "owners_ui:panel_clicks": ">=2" } },
    { "do": "pause_menu", "open": false },
    { "do": "wait", "s": 3 }
  ],
  "launch_args": ["-e33role=host", "-e33port=7777", "-e33seed=7", "-e33name=Killian", "-e33lang=fr"],
  "fakepeer": { "start": "after_game", "args": ["client", "--connect", "127.0.0.1:7777", "--script", "{repo}/tests/scenarios/fakeclient_panel.json", "--timeout", "600"] },
  "expect": { "snapshots_sent": "1", "joined_players": "1", "owner_reassignments": ">=2", "owners_ui:panel_navs": ">=2",
              "owners_ui:panel_back": "1", "owners_ui:nav_bind_errors": "0", "owners_ui:pause_errors": "0", "inputs_injected": ">=12" }
}
