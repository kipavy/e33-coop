    { "do": "wait", "s": 3 },
    { "do": "set_party", "party": ["Maelle", "Verso", "Monoco"] },
    { "do": "wait", "s": 3 },
    { "do": "world_battle", "engage": 1 },
    { "do": "wait_world", "s": 3 },
    { "do": "wait", "s": 3 },
    { "do": "reassign", "index": 2 },
    { "do": "wait", "s": 3 },
    { "do": "world_battle", "engage": 0 },
    { "do": "wait_world", "s": 3 },
    { "do": "wait", "s": 3 }
  ],
  "launch_args": ["-e33role=host", "-e33port=7777", "-e33seed=1865", "-e33owners=Verso:1"],
  "fakepeer": { "start": "after_game", "args": ["client", "--connect", "127.0.0.1:7777", "--script", "{repo}/tests/scenarios/fakeclient_world.json", "--save-out", "{run}/snapshot-received.sav", "--record", "{run}/recording-fakeclient.jsonl", "--timeout", "900"] },
  "expect": { "snapshots_sent": "1", "joined_players": "1", "party_changes": "1", "battle_notices_sent": ">=2", "world_battles": ">=2",
              "owner_reassignments": "1", "actions_skip": ">=1", "snapshot_errors": "0" }
