{
  "name": "p3_actions_client",
  "description": "Phase 3 : vrai jeu client face au faux hôte qui rejoue p3_actions_host. Le client joue Verso (mêmes actions que le faux client, QTE joués par de vrais appuis), rejoue les actions de Lune reçues de l'hôte avec ses résultats de QTE, et doit rester identique à l'hôte sans correction.",
  "save": "e33coop-test/TEST_B",
  "encounter": "SM_Lancelier_Alpha",
  "party": ["Verso", "Lune"],
  "timeout_s": 600,
  "max_turns": 40,
  "shots_every_s": 6,
  "actions": [
    { "hero": "Verso", "type": "skill", "skill": "Combo1", "combo": ["perfect", "success", "fail"] },
    { "hero": "Verso", "type": "attack" },
    { "hero": "Verso", "type": "item", "item": "Consumable_Energy_Level2", "target": "hero:Verso" },
    { "hero": "Verso", "type": "attack" }
  ],
  "defense": ["parry", "fail"],
  "launch_args": ["-e33role=client", "-e33connect=127.0.0.1:7777"],
  "fakepeer": { "start": "before_game", "args": ["host", "--port", "7777", "--replay", "{repo}/tests/recordings/p3_actions_host.jsonl", "--timeout", "600"] },
  "expect": { "battle_end": "any", "remote_actions": ">=2", "combos_replayed": ">=2", "combo_presses": ">=1", "rewards_checked": "any" }
}
