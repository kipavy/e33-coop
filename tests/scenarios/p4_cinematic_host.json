  "expect": { "snapshots_sent": "1", "joined_players": "1", "cinematics_skipped": "1", "narratives_started": ">=1", "narratives_finished": ">=1", "barrier_waits": ">=1", "barrier_releases": ">=1", "barrier_timeouts": "0" }
