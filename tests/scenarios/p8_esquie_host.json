{
  "name": "p8_esquie_host",
  "description": "Esquie (carte du monde, D19/D20) : vrai jeu hôte (pilote) face au faux client. Save de fin de partie TEST_LATE (tour de Cléa), passage sur la carte du monde, marche, montée sur Esquie (événement de la touche de monture appelé par le code), marche d'Esquie, décollage (événement de saut), vol, montée, descente, atterrissage, nouveau vol, retour au sol, descente d'Esquie, marche. Aucune touche simulée. Produit l'enregistrement rejoué par p8_esquie_client.",
  "save": "e33coop-test/TEST_LATE",
  "timeout_s": 700,
  "actions": [{ "type": "flee" }],
  "defense": ["fail"],
  "explore": [
    { "do": "wait_join", "players": 1, "timeout": 300 },
    { "do": "wait", "s": 3 },
    { "do": "change_map", "level": "Level_WorldMap_Main_V2" },
    { "do": "wait", "s": 5 },
    { "do": "wait_world", "s": 5, "timeout": 240 },
    { "do": "wait", "s": 8 },
    { "do": "move", "dir": [0, 1], "s": 3 },
    { "do": "wait", "s": 2 },
    { "do": "mount", "op": "call", "target": "controller", "fn": "InpActEvt_WorldMap_MountAction_K2Node_EnhancedInputActionEvent_2" },
    { "do": "mount", "op": "wait_mount", "is": true, "timeout": 20 },
    { "do": "mount", "op": "watch", "s": 3, "label": "mounted" },
    { "do": "mount", "op": "move", "dir": [1, 0, 0], "s": 4, "label": "esquie_walk" },
    { "do": "mount", "op": "watch", "s": 2, "label": "before_takeoff" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2" },
    { "do": "mount", "op": "watch", "s": 3, "label": "takeoff" },
    { "do": "mount", "op": "move", "dir": [1, 0, 0], "s": 5, "label": "fly_x" },
    { "do": "mount", "op": "move", "dir": [0, 1, 0.3], "s": 3.5, "label": "fly_y_up" },
    { "do": "mount", "op": "watch", "s": 2, "label": "hover" },
    { "do": "mount", "op": "move", "dir": [0, 0, -1], "s": 2.5, "label": "descend" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "optional": true },
    { "do": "mount", "op": "watch", "s": 4, "label": "landing" },
    { "do": "mount", "op": "move", "dir": [0, 1, 0], "s": 3, "label": "after_landing_move" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "optional": true },
    { "do": "mount", "op": "watch", "s": 3, "label": "takeoff2" },
    { "do": "mount", "op": "move", "dir": [-1, -1, 0], "s": 4, "label": "fly_back" },
    { "do": "mount", "op": "move", "dir": [0, 0, -1], "s": 2.5, "label": "descend2" },
    { "do": "mount", "op": "call", "target": "possessed", "fn": "InpActEvt_JumpAction_K2Node_EnhancedInputActionEvent_2", "optional": true },
    { "do": "mount", "op": "watch", "s": 4, "label": "landing2" },
    { "do": "mount", "op": "call", "target": "controller", "fn": "OnDismountRequested", "optional": true },
    { "do": "mount", "op": "watch", "s": 4, "label": "after_dismount" },
    { "do": "move", "dir": [1, 0], "s": 3 },
    { "do": "wait", "s": 4 }
  ],
  "launch_args": ["-e33role=host", "-e33port=7777", "-e33seed=1865"],
  "fakepeer": { "start": "after_game", "args": ["client", "--connect", "127.0.0.1:7777", "--script", "{repo}/tests/scenarios/fakeclient_follow.json", "--save-out", "{run}/snapshot-received.sav", "--record", "{run}/recording-fakeclient.jsonl", "--timeout", "700"] },
  "expect": { "snapshots_sent": "1", "joined_players": "1", "map_changes_published": ">=1", "mount:mount_calls_ok": ">=3" }
}
