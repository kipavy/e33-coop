{
  "name": "p6_panelnav_host",
  "description": "Panneau Coop navigable comme le menu du jeu, par les fonctions du jeu (aucune vraie touche) : lignes en boutons du jeu, focus (SetFocus), clic (HandleButtonClicked : souris / Entrée / A), gauche-droite (diffusion de la navigation contrainte du bouton), raccourci F9 (le focus suit), Retour (focus rendu au menu, menu toujours ouvert). Save TEST_B, équipe Maelle, Verso, Monoco ; Monoco donné au faux client par un clic puis rendu par « droite ». Captures toutes les 2 s : vérifier à l'œil le bouton qui a le focus dans shots/*.png.",
  "save": "e33coop-test/TEST_B",
  "timeout_s": 600,
  "shots_every_s": 2,
  "actions": [{ "type": "attack" }],
  "defense": ["fail"],
  "explore": [
    { "do": "wait_join", "players": 1, "timeout": 300 },
    { "do": "wait", "s": 3 },
    { "do": "set_party", "party": ["Maelle", "Verso", "Monoco"] },
    { "do": "wait", "s": 2 },
    { "do": "pause_menu", "open": true },
    { "do": "wait", "s": 2, "check": { "panel:buttons": "9", "panel:focused_row": "-1" } },
    { "do": "panel_focus", "row": 1 },
    { "do": "wait", "s": 2, "check": { "panel:focused_row": "1", "panel:selected": "1" } },
    { "do": "panel_click", "row": 2 },
    { "do": "wait", "s": 3, "check": { "panel:focused_row": "2", "owner_reassignments": "1" } },
    { "do": "panel_nav", "row": 2, "dir": "right" },
    { "do": "wait", "s": 3, "check": { "panel:focused_row": "2", "owner_reassignments": "2" } },
    { "do": "panel_focus", "row": 4 },
    { "do": "wait", "s": 1, "check": { "panel:focused_row": "4", "panel:selected": "4" } },
    { "do": "panel_nav", "row": 4, "dir": "left" },
    { "do": "wait", "s": 2 },
    { "do": "panel_click", "row": 4 },
    { "do": "wait", "s": 2, "check": { "options:option_changes": "2", "panel:focused_row": "4" } },
    { "do": "panel", "row": 5 },
    { "do": "wait", "s": 2, "check": { "panel:focused_row": "5" } },
    { "do": "panel_back" },
    { "do": "wait", "s": 2, "check": { "panel:focused_row": "-1", "panel:selected": "-1", "panel:menu_focus": "1", "panel:menu_visible": "1" } },
    { "do": "pause_menu", "open": false },
    { "do": "wait", "s": 3 }
  ],
  "launch_args": ["-e33role=host", "-e33port=7777", "-e33seed=7", "-e33name=Killian", "-e33lang=fr"],
  "fakepeer": { "start": "after_game", "args": ["client", "--connect", "127.0.0.1:7777", "--script", "{repo}/tests/scenarios/fakeclient_panel.json", "--timeout", "600"] },
  "expect": { "snapshots_sent": "1", "joined_players": "1", "party_changes": "1", "owner_reassignments": "2",
              "panel_focus_ok": "2", "panel_click_ok": "2", "panel_nav_ok": "2", "panel_back_ok": "1",
              "options:panel_changes": "2", "options:option_changes": "2",
              "owners_ui:panel_clicks": "2", "owners_ui:panel_navs": "2", "owners_ui:panel_refused": "0", "owners_ui:panel_back": "1",
              "owners_ui:panel_buttons_built": ">=2", "owners_ui:nav_bind_errors": "0", "owners_ui:nav_build_errors": "0",
              "owners_ui:pause_errors": "0" }
}
