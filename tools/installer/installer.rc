// Ressources de « Installer E33 Coop.exe » : manifeste (contrôles communs v6 pour TaskDialog, sans élévation), icône
// (générée au build par mkicon), informations de version (Propriétés > Détails).
#include <winver.h>
#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION E33COOP_VERSION_COMMAS,0
 PRODUCTVERSION E33COOP_VERSION_COMMAS,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kipavy (github.com/kipavy/e33-coop)"
            VALUE "FileDescription", "E33 Coop - installateur du mod coop (Clair Obscur: Expedition 33)"
            VALUE "FileVersion", E33COOP_VERSION_STR
            VALUE "InternalName", "E33CoopInstaller"
            VALUE "LegalCopyright", "Copyright (C) 2026 Killian (kipavy). GPL-3.0"
            VALUE "OriginalFilename", "Installer E33 Coop.exe"
            VALUE "ProductName", "E33 Coop"
            VALUE "ProductVersion", E33COOP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
